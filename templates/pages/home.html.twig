{% extends 'base.html.twig' %}

{% block title 'Union des Entreprises du Monde Agricole et Forestier | UNEMAF' %}

{% block stylesheets %}
<style type="text/css">


.el-carousel__item:nth-child(2n) {
    background-color: #99a9bf;
}
.el-carousel__item:nth-child(2n+1) {
    background-color: #d3dce6;
}
.el-dropdown-menu {
	background-color: #373C43;
}
.el-dropdown-menu__item:focus, .el-dropdown-menu__item:not(.is-disabled):hover {
	background-color: initial;
	color: initial;
}
.el-popper[x-placement^="bottom"] .popper__arrow::after {
	border-bottom-color: #373C43;
}
.el-carousel__container {
	box-shadow: 0 1px 5px 0 #4a4a4a;
}

.news-ticker .child {
  width: 3035px;
  display: inline-block;
  animation: marquee 20s linear infinite;
}
@keyframes marquee {
  0% {
    margin-left: 0;
  }
  100% {
    margin-left: calc(-3035px + 608px);
  }
}
.news-ticker .child:hover {
    -webkit-animation-play-state: paused;
    -moz-animation-play-state: paused;
    -o-animation-play-state: paused;
    animation-play-state: paused;
}

.snp-pop-10029 .snp-bld-step-cont-1 {}.snp-pop-10029 .snp-bld-step-1 {width: 500px;height: 500px;background-position: center center;background-repeat: repeat;}.snp-pop-10029 .bld-step-1-el-0 {   border: 1px solid transparent;width: 1144px;height: 312px;top: 77.9375px;left: -328.75px;z-index: 100;}.snp-pop-10029 .bld-step-1-el-0 .bld-el,.snp-pop-10029 .bld-step-1-el-0 .bld-el p,.snp-pop-10029 .bld-step-1-el-0 .bld-el:focus,.snp-pop-10029 .bld-step-1-el-0 .bld-el:active,.snp-pop-10029 .bld-step-1-el-0 .bld-el:hover{outline: 0;}#snp-pop-10029-overlay {opacity: 0.8;background-color: #5A5757;}

</style>
{% endblock %}

{% block body %}
    <section id="inner" class="container">
    	<div class="row">
           	<div class="col-md-7">
			   	<div id="carouselExampleIndicators" class="carousel slide border mb-5" data-ride="carousel">
					<ol class="carousel-indicators">
						{% for key, slide in sliders %}
							<li data-target="#carouselExampleIndicators" data-slide-to="{{key}}" {% if loop.first %}class="active"{% endif %}></li>
						{% endfor %}
					</ol>
					<div class="carousel-inner">
						{% for key, slide in sliders %}
							<div class="carousel-item {% if loop.first %}active{% endif %}">
								<img class="d-block w-100" src="{{ asset('uploads/' ~ slide.image.source) }}" alt="{{slide.libelle|default(null)}}" height="350" style="object-fit: cover">
								<div class="carousel-caption d-none d-md-block">
									<h5 class="text-white">{{slide.libelle}}</h5>
									<p>{{slide.text}}</p>
								</div>
							</div>
						{% endfor %}
					</div>
					<a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
						<span class="carousel-control-prev-icon" aria-hidden="true"></span>
						<span class="sr-only">Previous</span>
					</a>
					<a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
						<span class="carousel-control-next-icon" aria-hidden="true"></span>
						<span class="sr-only">Next</span>
					</a>
				</div>
				<div class="border mb-5">
					<div class="row">
						<header class="col-12">
							<h5 class="widget-title border-bottom bg-grey-o m-0 p-3"><a href="{{ path('list_activite', {'slug': 'Activités du conseil et de la Direction'|slug|lower}) }}">Activités du Conseil et de la Direction</a></h5>
						</header>
						{% if activites|first %}
						<div class="{{ activites|length != 1 ? 'col-md-6' : 'col-12' }}">
							<article class="category-a-la-une p-3 pr-3 pr-md-0">
								<a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}"><img src="{{ asset('uploads/' ~ activity.couverture.source|default('sansImg2.png')) }}" alt="{{ activity.titre }}" width="100%" height="180"></a>
								<div class="mt-3">
									<a class="widget-title" href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}">{{ activity.titre }}</a>
									<div class="mom-post-meta nb-item-meta">
										<small style="color:#6a7078">{{ activity.dateActivity|date('l m Y à H:m') }}</small>
									</div>
									{# <p>{{ activity.description|striptags|slice(0, 110)|raw }}... <a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}" class="read-more-link">Lire la suite</a></p> #}
								</div>
							</article>
						</div>
						{% endif %}
						{% if activites|length > 1 %}
						<div class="col-md-6 pl-3 pl-md-0">
							<div class="bg-grey-o p-3">
								{% for activity in activites|filter(a => a.type.libelle == 'Activités du conseil et de la Direction')|slice(1,6) %}
								<article class="row mb-4">
									<div class="col-4">
										<a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}"><img src="{{ asset('uploads/' ~ activity.couverture.source|default('sansImg2.png')) }}" data-hidpi="{{ asset('uploads/' ~ activity.couverture.source) }}" alt="{{ activity.titre }}" width="90" height="60"></a>
									</div>
									<div class="col-8">
										<a class="widget-title" href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}">{{ activity.titre|slice(0, 35) }}</a>
										<div class="mom-post-meta nb-item-meta">
											<small style="color:#6a7078">{{ activity.dateActivity|date('l m Y à H:m') }}</small>
										</div>
									</div>
								</article>
								{% if not loop.last and not loop.first %}<hr>{% endif %}
								{% endfor %}
							</div>
						</div>
						{% endif %}
						<footer class="col-12">
							<div class="text-center border-top py-2">
								<a href="{{ path('list_activite', {'slug': 'Activités du conseil et de la Direction'|slug|lower}) }}" class="btn btn-link">Voir plus <i class="fa fa-long-arrow-right ml-2"></i> </a>
							</div>
						</footer>
					</div> 
				</div>
				<div class="border mb-5">
					<div class="row">
						<header class="col-12">
							<h5 class="widget-title border-bottom bg-grey-o m-0 p-3"><a href="{{ path('list_activite', {'slug': "Activités majeures de l'UNEMAF"|slug|lower}) }}">Activités majeures de l'UNEMAF</a></h5>
						</header>
						{% for activity in activites|filter(a => a.type.libelle == "Activités majeures de l'UNEMAF") %}
							{% if loop.first %}
							<div class="col-12">
								<div class="p-3">
									<article class="row">
										<div class="col-12 mb-3">
											<a class="widget-title" href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}">{{ activity.titre }}</a>
											<div class="mom-post-meta nb-item-meta">
												<small style="color:#6a7078">{{ activity.dateActivity|date('l m Y à H:m') }}</small>
											</div> 
										</div> 
										<div class="col-md-6 mb-3">
											<a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}"><img src="{{ asset('uploads/' ~ activity.couverture.source|default('sansImg2.png')) }}" alt="{{ activity.titre }}" data-hidpi="{{ asset('uploads/' ~ activity.couverture.source) }}" width="100%" height="173"></a>
										</div>
										<div class="col-md-6">
											<p class="text-justify">{{ activity.description|striptags|slice(0, 250)|raw }}... <a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}" class="btn btn-link">Lire la suite <i class="fa fa-arrow-right"></i></a></p>
										</div>
									</article>
								</div> 
							</div> 
							{% else %}
							<div class="col-md-6">
								<div class="bg-grey-o p-3">
									<article class="row">
										<div class="col-4">
											<a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}"><img src="{{ asset('uploads/' ~ activity.couverture.source|default('sansImg2.png')) }}" data-hidpi="{{ asset('uploads/' ~ activity.couverture.source) }}" alt="{{ activity.titre }}" width="90" height="60"></a>
										</div>
										<div class="col-8">
											<a class="widget-title" href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}">{{ activity.titre|slice(0, 35) }}</a>
											<div class="mom-post-meta nb-item-meta">
												<small style="color:#6a7078">{{ activity.dateActivity|date('l m Y à H:m') }}</small>
											</div> 
										</div>
									</article>
								</div>
								{% if not loop.last and not loop.first %}<hr>{% endif %}
							</div>
							{% endif %}
						{% endfor %}
						<footer class="col-12">
							<div class="text-center border-top py-2">
								<a href="{{ path('list_activite', {'slug': "Activités majeures de l'UNEMAF"|slug|lower}) }}" class="btn btn-link">Voir plus <i class="fa fa-long-arrow-right ml-2"></i> </a>
							</div>
						</footer>
					</div>
				</div>
				<div class="border mb-5">
					<div class="row">
						<div class="col-12">
							<nav class="bg-grey-o">
								<div class="nav nav-tabs" id="nav-tab" role="tablist">
									{% for type in docTypes|filter(t => t.activities|length != 0) %}
									<a class="btn btn-link widget-title border-right border-bottom {% if loop.first %}active{% endif %}" id="nav-{{type.slug}}-tab" data-toggle="tab" href="#nav-{{type.slug}}" role="tab" aria-controls="nav-{{type.slug}}" aria-selected="true">{{type.libelle}}</a>
									{% endfor %}
								</div>
							</nav>
							<div class="tab-content p-3" id="nav-tabContent">
								{% for type in docTypes|filter(t => t.activities|length != 0) %}
								<div class="tab-pane fade {% if loop.first %}show active{% endif %}" id="nav-{{type.slug}}" role="tabpanel" aria-labelledby="nav-{{type.slug}}-tab">
									<h5>{{type.libelle}}</h5>
									{% for activity in activites|filter(a => a.type.libelle == type.libelle) %}
										<article class="row mt-3">
											<div class="col-4">
												<a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}"><img src="{{ asset('uploads/' ~ activity.couverture.source|default('sansImg2.png')) }}" data-hidpi="{{ asset('uploads/' ~ activity.couverture.source) }}" alt="{{ activity.titre }}" width="100%" height=""></a>
											</div>
											<div class="col-8">
												<a class="widget-title" href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}">{{ activity.titre|slice(0, 35) }}</a>
												<div class="mom-post-meta nb-item-meta">
													<small style="color:#6a7078">{{ activity.dateActivity|date('l m Y à H:m') }}</small>
												</div> 
												<p>{{ activity.description|striptags|slice(0, 100)|raw }}... <a href="{{ path('activite', {type: activity.type.slug, slug: activity.slug}) }}" class="read-more-link">Lire la suite</a></p>
											</div>
										</article>
										{% if not loop.last %}<hr>{% endif %}
									{% endfor %}
								</div>
								{% endfor %}
							</div>
						</div>
						<footer class="col-12">
							<div class="text-center border-top py-2">
								<a href="" class="btn btn-link">Voir plus <i class="fa fa-long-arrow-right ml-2"></i> </a>
							</div>
						</footer>
					</div>
				</div>
				<div class="border mb-5">
					<div class="row">
						<header class="col-12">
							<h5 class="widget-title border-bottom bg-grey-o m-0 p-3"><a href="">Photothèque</a></h5>
						</header>
					</div>
					<div class="row p-3">
						{% for photo in photos|filter(p => p.categ == "photo")|slice(0, 24) %}
							<div class="col-sm-3 mb-3">
								<a href="" data-tooltip="{{photo.alt}}" class=""><img src="{{ asset('uploads/'~ photo.source|default('sansImg2.png')) }}" alt="{{photo.alt}}" width="100%" height="75"></a>
							</div>
						{% endfor %}
					</div> 
    			</div>
    		</div>

    		<div class="col-md-2 secondary-sidebar p-0">
				{{ render(controller(
					'App\\Controller\\HomeController::secondarySidebar'
				)) }}
        		{# {% include 'pages/_secondarySidebar.html.twig' %} #}
			</div> 
			
			<div class="col-md-3 main-sidebar">
				{% include 'pages/_mainSidebar.html.twig' %}
			</div> 
       	</div>
   	</section> 
{% endblock %}

{% block javascripts %}
<script>

</script>
{% endblock %}