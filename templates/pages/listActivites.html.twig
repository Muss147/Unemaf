{% extends 'base.html.twig' %}

{% block title "Liste activités" %}

{% block stylesheets %}
<style type="text/css">
  .text {
    font-size: 14px;
  }
  .item {
    margin-bottom: 18px;
  }
  .clearfix:before,
  .clearfix:after {
    display: table;
    content: "";
  }
  .clearfix:after {
    clear: both
  }
  .box-card {
    margin-bottom: 15px;
  }
  .desc {
      height: 110px;
      overflow: hidden;
      text-overflow: ellipsis;
  }
</style>
{% endblock %}

{% block body %}
  <section id="inner" class="container">
    <div class="row">
      <div class="col-md-7">
        <div class="ariane border-bottom text-uppercase py-2 mb-4">
          <a href="{{path('home')}}" style="color:#6a7078">Accueil</a> <i class="material-icons" style="vertical-align: bottom">keyboard_arrow_right</i>
          <strong class="text-dark">{{type.libelle}}</strong>
        </div>
        <div class="border bg-grey-o py-2 px-3 mb-4">
          <h5 class="widget-title">{{type.libelle}}</h5>
        </div>
        <div id="carouselExampleIndicators" class="carousel slide border mb-5" data-ride="carousel">
          <ol class="carousel-indicators">
            {% for key, slide in sliders %}
              <li data-target="#carouselExampleIndicators" data-slide-to="{{key}}" {% if loop.first %}class="active"{% endif %}></li>
            {% endfor %}
          </ol>
          <div class="carousel-inner">
            {% for key, slide in sliders %}
              <div class="carousel-item {% if loop.first %}active{% endif %}">
                <img class="d-block w-100" src="{{ asset('uploads/images/' ~ slide.image.source) }}" alt="{{slide.libelle|default(null)}}" height="350" style="object-fit: cover">
                <div class="carousel-caption d-none d-md-block">
                  <h5>{{slide.libelle}}</h5>
                  <p>...</p>
                </div>
              </div>
            {% endfor %}
          </div>
          <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
          </a>
          <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
          </a>
        </div>
        {% for activity in activites %}
        <div class="shadow-sm border p-3">
          <article class="row">
            <div class="col-12 mb-3">
              <a class="widget-title" href="{{ path('activite', {type: activity.type.libelle|slug, slug: activity.slug}) }}">{{ activity.titre }}</a>
              <div class="mom-post-meta nb-item-meta">
                <small style="color:#6a7078">{{ activity.dateActivity|date('l m Y à H:m') }}</small>
              </div> 
            </div> 
            <div class="col-md-6 mb-3">
              <a href="{{ path('activite', {type: activity.type.libelle|slug, slug: activity.slug}) }}"><img src="{{ asset('uploads/images/' ~ activity.couverture.source|default('sansImg2.png')) }}" alt="{{ activity.titre }}" data-hidpi="{{ asset('uploads/images/' ~ activity.couverture.source) }}" width="100%" height="173"></a>
            </div>
            <div class="col-md-6">
              <p class="text-justify">{{ activity.description|striptags|slice(0, 250)|raw }}... <a href="{{ path('activite', {type: activity.type.libelle|slug, slug: activity.slug}) }}" class="btn btn-link">Lire la suite <i class="fa fa-arrow-right"></i></a></p>
            </div>
          </article>
        </div>
        {% endfor %}
      </div>

      <div class="col-md-2 secondary-sidebar p-0">
        {{ render(controller(
          'App\\Controller\\HomeController::secondarySidebar'
        )) }}
      </div> 
    
      <div class="col-md-3 main-sidebar">
        {% include 'pages/_mainSidebar.html.twig' %}
      </div> 
    </div>
  </section> 
{% endblock %}

{% block javascripts %}
<script>

</script>
{% endblock %}
