{% extends 'base.html.twig' %}

{% block title menu.libelle %}

{% block stylesheets %}
<style type="text/css">

</style>
{% endblock %}

{% block body %}
    <section id="inner" class="container">
    	<div class="row">
           	<div class="col-md-9">
                <div class="ariane border-bottom text-uppercase py-2 mb-4">
                    <a href="{{path('home')}}" style="color:#6a7078">Accueil</a> <i class="material-icons" style="vertical-align: bottom">keyboard_arrow_right</i>
                    <strong class="text-dark">{{menu.libelle}}</strong>
                </div>
                <div class="border bg-grey-o py-3 px-4 mb-4">
                    <h3 class="widget-title my-3">{{menu.libelle}}</h3>
                    <hr>
                    <div class="row mt-5">
                        {% if menu.presentation != 'Aucune' %}
                            <div class="col-{% if menu.presentation == 'Verticale' %}md-3{% else %}12 pb-5{% endif %}">
                                <div class="nav {% if menu.presentation == 'Verticale' %}flex-column{% endif %} nav-pills" id="v-pills-tab" role="tablist" {% if menu.presentation == 'Verticale' %}aria-orientation="vertical"{% endif %}>
                                    {% for page in pages %}
                                    <a class="btn btn-link border py-2 {% if loop.first %}active{% endif %}" id="v-pills-{{page.slug}}-tab" data-toggle="pill" href="#{{page.slug}}" role="tab" aria-controls="v-pills-{{page.slug}}" aria-selected="true">{{page.titre}}</a>
                                    {% endfor %}
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="tab-content" id="v-pills-tabContent">
                                    {% for page in pages %}
                                    <div class="tab-pane fade {% if loop.first %}show active{% endif %}" id="{{page.slug}}" role="tabpanel" aria-labelledby="v-pills-{{page.slug}}-tab">
                                        {{page.description|raw}}
                                    </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                {{page.description|default('Page vide')|raw}}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

			<div class="col-md-3 main-sidebar">
				{% include 'pages/_mainSidebar.html.twig' %}
			</div> 
       	</div>
   	</section> 
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    var url_string = window.location.href;
    var url = new URL(url_string);
    $('a[href="'+url.hash+'"]').tab('show')
});
</script>
{% endblock %}
