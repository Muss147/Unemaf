{% extends 'base.html.twig' %}

{% block title 'Se connecter' %}

{% block body %}
    <section class="container my-4" align="center">

        <h3 class="widget-title text-center my-3">Connexion à l'espace Admin</h3>

        {% if error %}
            <div class="alert alert-danger">
                {{ error.messageKey | trans(error.messagedata, 'security') }}
            </div>
        {% endif %}

        <div class="d-flex justify-content-center my-5">
            <form class="w-50" action="{{ path('login') }}" method="post">
                <div class="form-group">
                    <label for="username">Nom d'utilisateur</label>
                    <input type="text" id="username" name="_username" class="form-control" value="{{ last_username }}">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="form-group">
                    <label for="password">Mot de passe</label>
                    <input type="password" id="password" name="_password" class="form-control">
                </div>
                <div class="form-group text-center">
                    <button type="submit" class="btn btn-prm">Se connecter</button>
                </div>
            </form>
        </div>
    </section>

{% endblock %}