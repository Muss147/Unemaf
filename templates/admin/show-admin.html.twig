{% block script %}
<script src="assets/js/pages/custom/user/profile.js" type="text/javascript"></script>

<script  type="text/javascript">
$('input[name=pswd]').keyup(function() {
	var pswd = this.value;
	if (pswd.length < 8 || !pswdCheck(pswd)) $(this).css('border', "1px solid #fd397a");
	else $(this).css('border', "1px solid #e2e5ec");
});

$('input[name=v_pswd]').keyup(function() {
	var pswd = $('input[name=pswd]')[0].value;
	var v_pswd = this.value;
	if (pswd != v_pswd) $(this).css('border', "1px solid #fd397a");
	else $(this).css('border', "1px solid #e2e5ec");
});

function pswdCheck(pswd) {
    return /^[A-Za-z0-9\d=!\-@._*]*$/.test(pswd) // consists of only these
       && /[a-z]/.test(pswd) // has a lowercase letter
       && /\d/.test(pswd) // has a digit
};

{% if ('ROLE_SUPER_ADMIN' not in user.roles and 'ROLE_SUPER_ADMIN' not in app.user.roles) %}
	$('input, select').attr('disabled', true);
{% endif %}
</script>
{% endblock %}