																</span>
															</div>
														</div>
													</div>
													<div class="form-group row">
														<label class="col-xl-3 col-lg-3 col-form-label">Prénom <sup>*</sup></label>
														<div class="col-lg-9 col-xl-9">
															<input class="form-control" type="text" name="prenom" required>
														</div>
													</div>
													<div class="form-group row">
														<label class="col-xl-3 col-lg-3 col-form-label">Nom <sup>*</sup></label>
														<div class="col-lg-9 col-xl-9">
															<input class="form-control" type="text" name="nom" required>
														</div>
													</div>
													<div class="form-group row">
														<label class="col-xl-3 col-lg-3 col-form-label">Contact</label>
														<div class="col-lg-9 col-xl-9">
															<div class="input-group">
																<div class="input-group-prepend"><span class="input-group-text"><i class="la la-phone"></i></span></div>
																<input type="number" class="form-control" name="contact" placeholder="Votre numéro de téléphone" aria-describedby="basic-addon1">
															</div>
														</div>
													</div>
													<div class="form-group row">
														<label class="col-xl-3 col-lg-3 col-form-label">Adresse Email <sup>*</sup></label>
														<div class="col-lg-9 col-xl-9">
															<div class="input-group">
																<div class="input-group-prepend"><span class="input-group-text"><i class="la la-at"></i></span></div>
																<input type="email" class="form-control" name="email" placeholder="Votre Email" aria-describedby="basic-addon1" required>
															</div>
															<span class="form-text text-muted">Nous ne partagerons jamais votre e-mail avec quelqu'un d'autre.</span>
														</div>
													</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>

