														</div>
													</div>
													<div class="form-group row">
														<label class="col-xl-3 col-lg-3 col-form-label">UserName <sup>*</sup></label>
														<div class="col-lg-9 col-xl-9">
															<input class="form-control" type="text" name="username" required>
														</div>
													</div>
													<div class="form-group row">
