											<div class="kt-wizard-v4__review-title">
												Details Perso
											</div>
											<div id="detailPerso" class="kt-wizard-v4__review-content">
												
											</div>
										</div>
										<div class="kt-wizard-v4__review-item">
											<div class="kt-wizard-v4__review-title">
												Details Admin
											</div>
											<div id ="detailAdmin" class="kt-wizard-v4__review-content">
												
											</div>
										</div>
									</div>
								</div>
							</div>

							<!--end: Form Wizard Step 4-->

							<!--begin: Form Actions -->
							<div class="kt-form__actions">
								<div class="btn btn-secondary btn-md btn-tall btn-wide kt-font-bold kt-font-transform-u" data-ktwizard-type="action-prev">
									Précédent
								</div>
								<div class="btn btn-success btn-md btn-tall btn-wide kt-font-bold kt-font-transform-u" data-ktwizard-type="action-submit" name="newAdmin">
									Soumettre
								</div>
								<div class="btn btn-brand btn-md btn-tall btn-wide kt-font-bold kt-font-transform-u" data-ktwizard-type="action-next" onclick="resumDetail()">
									Suivant
								</div>
							</div>

							<!--end: Form Actions -->
						</form>

						<!--end: Form Wizard Form-->
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- end:: Content -->
{% endblock %}

{% block script %}
	<!--begin::Page Scripts(used by this page) -->
	<script src="{{asset('assets/js/pages/custom/user/add-user.js')}}" type="text/javascript"></script>
	<!--end::Page Scripts -->

<script  type="text/javascript">
$('.sccs').click(function() {;
    $(location).attr("/admin-list", url);
});
$('input[name=pswd]').keyup(function() {
	var pswd = this.value;
	if (pswd.length < 8 || !pswdCheck(pswd)) $(this).css('border', "1px solid #fd397a");
	else $(this).css('border', "1px solid #e2e5ec");
});

$('input[name=v_pswd]').keyup(function() {
	var pswd = $('input[name=pswd]')[0].value;
	var v_pswd = this.value;
	if (pswd != v_pswd) $(this).css('border', "1px solid #fd397a");
	else $(this).css('border', "1px solid #e2e5ec");
});

function pswdCheck(pswd) {
    return /^[A-Za-z0-9\d=!\-@._*]*$/.test(pswd) // consists of only these
       && /[a-z]/.test(pswd) // has a lowercase letter
       && /\d/.test(pswd) // has a digit
};
function resumDetail() {
	$('#detailPerso').html($('input[name=prenom]')[0].value+" "+$('input[name=nom]')[0].value+"<br /> <b>PHONE: </b>"+$('input[name=contact]')[0].value+"<br /> <b>EMAIL: </b>"+$('input[name=email]')[0].value);
	$('#detailAdmin').html("<b>USERNAME: </b>"+$('input[name=username]')[0].value+"<br /><b>RÔLE: </b>"+$('select')[0].value+"<br /><b>PASSWORD: </b><span class='mdp'>***********</span> <i class='fa fa-eye' onclick='voir(this)'></i>");
}

function voir(event) {
	if ($(event).hasClass('vue')) {
		$('.mdp').text('***********');
		$(event).attr('class', 'fa fa-eye');
	}
	else {
		$('.mdp').text($('input[name=pswd]')[0].value);
		$(event).attr('class', 'fa fa-eye-slash vue');
	}
}

$('.btn.btn-secondary.sccs').click(function() {
	alert('okey');
	console.log("redirection...");
	window.location.replace("{{path('admin.list')}}");
});
</script>
{% endblock %}